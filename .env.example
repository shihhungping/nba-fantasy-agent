# 複製成 .env 後填入。.env 已在 .gitignore,不要 commit。
# Yahoo Developer Network app (https://developer.yahoo.com/apps/create/),API Permissions 勾 Fantasy Sports (Read)
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=

# 本機第一次授權後由 yfpy 產生。雲端環境無法開瀏覽器,要把這段 JSON 放進雲端環境的 environment variables。
# 必要欄位: access_token, consumer_key, consumer_secret, guid, refresh_token, token_time, token_type
YAHOO_ACCESS_TOKEN_JSON=

# NBA 賽程 API (待申請,Phase 4)
NBA_DATA_API_KEY=
